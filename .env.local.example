# =============================================================================
# Copy this file to .env.local:
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored. It contains only public, browser-safe values.
# Server secrets live in studiospace-server/.env — never here.
# =============================================================================

# Origin of this Next.js app (no path).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Express API base, including /api.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
