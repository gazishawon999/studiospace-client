# =============================================================================
# StudioSpace Client — environment variables
#
# Only NEXT_PUBLIC_* values belong here. Next.js embeds them in the browser
# bundle, so they are public by definition and must never contain secrets.
#
# All credentials (MongoDB, Better Auth, Google OAuth, ImgBB) belong to the
# Express backend: studiospace-server/.env
# See docs/environment.md for details.
# =============================================================================

# Public origin of this Next.js app. Origin only — no path, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Express API. Must include the /api prefix: the client appends
# paths such as /studios and /auth (Better Auth is mounted at /api/auth).
NEXT_PUBLIC_API_URL=http://localhost:5000/api
