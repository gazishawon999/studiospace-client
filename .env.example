# Public App & Backend API URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Better Auth Configuration (Used in Phase 04)
BETTER_AUTH_SECRET=replace_with_32_char_minimum_secret_key
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/studiospace_db?retryWrites=true&w=majority
DB_NAME=studiospace_db

# Google OAuth Credentials (Used in Phase 04)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ImgBB Image Hosting API Key (Used in Phase 04 & 07)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key